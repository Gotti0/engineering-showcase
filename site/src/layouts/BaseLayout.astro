---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** 회사 공유 경로: 브랜드·전역 내비로 공개 홈/목록에 나가지 않음 */
  isolate?: boolean;
  /** 랜딩 슬라이드 덱: 헤더 내비·푸터 링크 없음 */
  slideDeck?: boolean;
}

const {
  title,
  description = '문제를 분리하고 검증으로 막는 백엔드·플랫폼 엔지니어 — 주문·데이터 경계와 검증 근거.',
  noindex = false,
  isolate = false,
  slideDeck = false,
} = Astro.props;
---
<!doctype html>
<html lang="ko" data-isolate={isolate ? '1' : undefined} data-deck={slideDeck ? '1' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600&family=Noto+Serif+KR:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class={`shell${slideDeck ? ' shell-deck' : ''}`}>
      <header class="site-header">
        <span class="brand">Engineering Showcase</span>
        {
          !isolate && !slideDeck && (
            <nav class="nav" aria-label="주요" data-public-nav>
              <span>소개</span>
              <span>프로젝트</span>
              <span>사례</span>
              <span>근거</span>
            </nav>
          )
        }
      </header>
      <slot />
      <footer class="site-footer" data-site-footer>
        <p>Gotti0 · 공개 경계와 합성 예제 한계는 이 자료의 근거 슬라이드를 따릅니다.</p>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var KEY = 'es-isolate';
        if (document.documentElement.getAttribute('data-isolate') === '1') {
          try {
            sessionStorage.setItem(KEY, '1');
          } catch (e) {}
        }
        var on = false;
        try {
          on = sessionStorage.getItem(KEY) === '1';
        } catch (e) {}
        if (!on) return;

        var nav = document.querySelector('[data-public-nav]');
        if (nav) nav.remove();
        document.querySelectorAll('[data-public-only]').forEach(function (el) {
          el.remove();
        });
      })();
    </script>
  </body>
</html>
