---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '문제를 분리하고 검증으로 막는 엔지니어 — 공개 엔지니어링 사례와 직무별 3분 읽기 경로.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600&family=Noto+Serif+KR:wght@600;700&display=swap"
      rel="stylesheet"
    />

  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={base}>Engineering Showcase</a>
        <nav class="nav" aria-label="주요">
          <a href={`${base}#personas`}>직무 경로</a>
          <a href={`${base}cases/`}>사례</a>
          <a href={`${base}evidence/`}>근거</a>
          <a href={`${base}examples/`}>예제</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>
          Gotti0 ·
          <a href="https://github.com/Gotti0/engineering-showcase">GitHub</a>
          · 공개 경계와 합성 예제 한계는
          <a href={`${base}evidence/`}>근거 목록</a>을 따릅니다.
        </p>
      </footer>
    </div>
  </body>
</html>
