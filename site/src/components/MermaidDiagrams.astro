---
import type { DiagramBlock } from '../data/diagrams';

interface Props {
  diagrams: DiagramBlock[];
}

const { diagrams } = Astro.props;
---
{
  diagrams.length > 0 && (
    <section class="diagram-section">
      <h2 class="diagram-heading">구조도 · 개념 ERD</h2>
      <p class="diagram-note">
        공개 설명을 위한 개념도입니다. 원본 운영 DB·실계좌·제품 스키마를 그대로 옮긴 것이 아닙니다.
      </p>
      {
        diagrams.map((d) => (
          <figure class="diagram-figure">
            <figcaption>
              <strong>{d.title}</strong>
              <span>{d.caption}</span>
            </figcaption>
            <pre class="mermaid">{d.mermaid}</pre>
          </figure>
        ))
      }
    </section>
  )
}

{
  diagrams.length > 0 && (
    <script is:inline>
      (function () {
        function boot() {
          if (!document.querySelector('pre.mermaid')) return;
          if (window.__esMermaidLoading) return;
          window.__esMermaidLoading = true;
          var s = document.createElement('script');
          s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
          s.onload = function () {
            window.mermaid.initialize({
              startOnLoad: false,
              theme: 'base',
              securityLevel: 'strict',
              themeVariables: {
                primaryColor: '#dfe8d8',
                primaryTextColor: '#14201a',
                primaryBorderColor: '#3f6b2a',
                lineColor: '#3d4f44',
                secondaryColor: '#f3f6f1',
                tertiaryColor: '#e8efe8',
              },
            });
            window.mermaid.run({ querySelector: 'pre.mermaid' });
          };
          document.head.appendChild(s);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', boot);
        } else {
          boot();
        }
      })();
    </script>
  )
}
