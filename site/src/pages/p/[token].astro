---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { audiences, getAudienceByToken } from '../../data/audiences';
import { getCase, BOUNDARY_NOTICE } from '../../lib/content';

export function getStaticPaths() {
  return audiences.map((a) => ({ params: { token: a.token } }));
}

const audience = getAudienceByToken(Astro.params.token!);
if (!audience) {
  throw new Error('Unknown path');
}

const cases = audience.caseSlugs.map((s) => getCase(s)).filter(Boolean);
const title = `${audience.role} — ${audience.company}`;
const total = 1 + cases.length;
---
<BaseLayout
  title={`${title} · Engineering Showcase`}
  description={audience.blurb}
  noindex={true}
  isolate={true}
  slideDeck={true}
>
  <div class="deck" aria-label={`${audience.company} 읽기 경로 슬라이드`}>
    <section class="slide slide-hero" data-slide="1">
      <p class="slide-brand">3분 읽기 경로</p>
      <h1 class="slide-hero-title" style="max-width: 18ch; font-size: clamp(2rem, 5vw, 3.2rem);">
        {title}
      </h1>
      <p class="slide-hero-lead">{audience.blurb}</p>
      <p class="notice slide-notice">{BOUNDARY_NOTICE}</p>
      <p class="slide-page">{`1 / ${total}`}</p>
    </section>

    {
      cases.map((c, i) => (
        <section class="slide" data-slide={String(i + 2)}>
          <header class="slide-header">
            <div>
              <p class="slide-kicker">{`Path ${i + 1}`}</p>
              <h2>{c!.title}</h2>
            </div>
            <span class="slide-page">{`${i + 2} / ${total}`}</span>
          </header>
          <p class="section-lead">{c!.excerpt}</p>
          <article class="prose" set:html={c!.html} />
          <p class="section-lead" style="margin-top: 1.5rem;">
            지원 자료의 읽기 안내이며 {audience.company}에 소속되거나 기업의 승인을 받은 자료가 아닙니다.
          </p>
        </section>
      ))
    }
  </div>
</BaseLayout>
