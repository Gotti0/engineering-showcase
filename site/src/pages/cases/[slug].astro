---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listCaseSlugs, getCase, BOUNDARY_NOTICE } from '../../lib/content';

export function getStaticPaths() {
  return listCaseSlugs().map((slug) => ({ params: { slug } }));
}

const doc = getCase(Astro.params.slug!);
if (!doc) throw new Error(`Unknown case: ${Astro.params.slug}`);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${doc.title} · Engineering Showcase`} description={doc.excerpt}>
  <section class="section" style="padding-top: var(--hero-pad);">
    <div class="meta-row" style="margin-top: 0;">
      <a href={`${base}cases/`}>← 사례 목록</a>
      <a href={`${base}#personas`}>직무 경로</a>
      <a href={`${base}evidence/`}>근거</a>
    </div>
    <p class="notice" style="margin-top: 1.25rem;">{BOUNDARY_NOTICE}</p>
    <article class="prose" set:html={doc.html} />
  </section>
</BaseLayout>
