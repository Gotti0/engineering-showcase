---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MermaidDiagrams from '../../components/MermaidDiagrams.astro';
import { listCaseSlugs, getCase, BOUNDARY_NOTICE } from '../../lib/content';
import { caseDiagrams } from '../../data/diagrams';

export function getStaticPaths() {
  return listCaseSlugs().map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const doc = getCase(slug);
if (!doc) throw new Error(`Unknown case: ${slug}`);
const diagrams = caseDiagrams[slug] ?? [];
---
<BaseLayout title={`${doc.title} · Engineering Showcase`} description={doc.excerpt} slideDeck={true}>
  <div class="deck">
    <section class="slide">
      <header class="slide-header">
        <div>
          <p class="slide-kicker">Case</p>
          <h2>{doc.title}</h2>
        </div>
      </header>
      <p class="notice slide-notice">{BOUNDARY_NOTICE}</p>
      <article class="prose" set:html={doc.html} />
      <MermaidDiagrams diagrams={diagrams} />
    </section>
  </div>
</BaseLayout>
