---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCase } from '../../lib/content';

/** 백엔드 채용 기본 읽기 순서 */
const orderedSlugs = [
  'order-and-operation-safety',
  'financial-data-validation',
  'llm-document-processing',
  'agent-development-workflow',
];
const cases = orderedSlugs.map((slug) => getCase(slug)).filter(Boolean);
---
<BaseLayout title="사례 · Engineering Showcase" slideDeck={true}>
  <div class="deck">
    <section class="slide">
      <header class="slide-header">
        <div>
          <p class="slide-kicker">Cases</p>
          <h2>백엔드 관점 사례</h2>
        </div>
      </header>
      <p class="section-lead">
        주문·브릿지·데이터 검증을 앞에 두고, 문서 잡·에이전트 운영은 보조로 둡니다. 본 목록은 텍스트만 제공합니다.
      </p>
      <ul class="bridge-list">
        {
          cases.map((c) => (
            <li>
              <div class="bridge-row">
                <span class="bridge-project">{c!.title}</span>
                <span class="bridge-focus">{c!.excerpt}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
