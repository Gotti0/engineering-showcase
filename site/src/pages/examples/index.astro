---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getExamples, BOUNDARY_NOTICE } from '../../lib/content';

const doc = getExamples();
---
<BaseLayout title="실행 예제 · Engineering Showcase" slideDeck={true}>
  <div class="deck">
    <section class="slide">
      <header class="slide-header">
        <div>
          <p class="slide-kicker">Examples</p>
          <h2>실행 예제</h2>
        </div>
      </header>
      <p class="notice slide-notice">{BOUNDARY_NOTICE}</p>
      <article class="prose" set:html={doc.html} />
    </section>
  </div>
</BaseLayout>
