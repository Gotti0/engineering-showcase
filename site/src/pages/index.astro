---
import BaseLayout from '../layouts/BaseLayout.astro';
import MermaidDiagrams from '../components/MermaidDiagrams.astro';
import { BOUNDARY_NOTICE } from '../lib/content';
import {
  profile,
  competencies,
  background,
  stackGroups,
  projectBridges,
  caseSlides,
  evidenceSlides,
  closing,
} from '../data/narrative';
import { landingOverview } from '../data/diagrams';

const base = import.meta.env.BASE_URL;
const photoSrc = `${base}${profile.photo}`;
const totalSlides = 9;
---

<BaseLayout title="Engineering Showcase — 이현우" slideDeck={true}>
  <div class="deck" aria-label="포트폴리오 슬라이드">
    <section class="slide slide-hero" data-slide="1">
      <p class="slide-brand">Engineering Showcase · {profile.name}</p>
      <h1 class="slide-hero-title">문제를 분리하고 검증으로 막는 엔지니어</h1>
      <p class="slide-hero-lead">
        백엔드·플랫폼 관점에서, 잘못된 상태와 데이터가 다음 단계로 넘어가지 않게 막는 설계를 우선합니다.
      </p>
      <p class="slide-page">{`1 / ${totalSlides}`}</p>
    </section>

    <section class="slide" data-slide="2" id="about">
      <header class="slide-header">
        <div>
          <p class="slide-kicker">Profile</p>
          <h2>금융 도메인을 다룬 백엔드·플랫폼 엔지니어</h2>
        </div>
        <span class="slide-page">{`2 / ${totalSlides}`}</span>
      </header>
      <div class="about-grid">
        <aside class="about-identity">
          <img class="about-photo" src={photoSrc} alt={`${profile.name} 프로필`} width="480" height="640" />
          <p class="about-name">
            <strong>{profile.name}</strong>
            <span>{profile.nameEn}</span>
          </p>
          <p class="about-role">{profile.role}</p>
          <ul class="contact-list">
            <li>{profile.email}</li>
            <li>{profile.githubHandle}</li>
            <li>{profile.educationLine}</li>
            <li>{profile.trainingLine}</li>
          </ul>
        </aside>
        <div>
          <h3 class="block-title">핵심 역량</h3>
          <ul class="comp-list">
            {
              competencies.map((c) => (
                <li>
                  <strong>{c.title}</strong>
                  <p>{c.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="slide" data-slide="3" id="background">
      <header class="slide-header">
        <div>
          <p class="slide-kicker">Background</p>
          <h2>학습과 검증 기록을 쌓아 온 이력</h2>
        </div>
        <span class="slide-page">{`3 / ${totalSlides}`}</span>
      </header>
      <div class="bg-grid">
        {
          background.map((b) => (
            <div class="bg-block">
              <h3 class="block-title">{b.title}</h3>
              <ul class="plain-list">
                {b.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="notice slide-notice">{BOUNDARY_NOTICE}</p>
    </section>

    <section class="slide" data-slide="4" id="stack">
      <header class="slide-header">
        <div>
          <p class="slide-kicker">Technical Inventory</p>
          <h2>금융 도메인과 시스템 밑바닥을 지탱하는 스택</h2>
        </div>
        <span class="slide-page">{`4 / ${totalSlides}`}</span>
      </header>
      <div class="stack-grid">
        {
          stackGroups.map((g) => (
            <div class="stack-block">
              <h3 class="block-title">{g.title}</h3>
              <ul class="plain-list">
                {g.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="slide" data-slide="5" id="projects">
      <header class="slide-header">
        <div>
          <p class="slide-kicker">Projects</p>
          <h2>백엔드 신호 강한 프로젝트부터</h2>
        </div>
        <span class="slide-page">{`5 / ${totalSlides}`}</span>
      </header>
      <p class="section-lead">
        코드 전문은 Pages에 올리지 않습니다. 공개 설명·비공개 면접 열람·합성 예제로 범위를 나눕니다.
      </p>
      <MermaidDiagrams diagrams={[landingOverview]} />
      <ul class="bridge-list">
        {
          projectBridges.map((p) => (
            <li>
              <div class="bridge-row">
                <span class="bridge-project">{p.project}</span>
                <span class="bridge-focus">{p.focus}</span>
                <span class="bridge-case">사례 · {p.caseLabel}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      caseSlides.map((c, i) => (
        <section class="slide" data-slide={String(6 + i)} id={`case-${i + 1}`}>
          <header class="slide-header">
            <div>
              <p class="slide-kicker">{c.kicker}</p>
              <h2>{c.title}</h2>
            </div>
            <span class="slide-page">{`${6 + i} / ${totalSlides}`}</span>
          </header>
          <div class="case-grid">
            <div class="ts-box">
              <p class="ts-header">문제와 역할</p>
              <p class="ts-body">{c.problem}</p>
            </div>
            <div class="ts-box">
              <p class="ts-header">구현 구조</p>
              <ul class="plain-list">
                {c.structure.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="ts-box ts-wide">
              <p class="ts-header">근거와 한계</p>
              <p class="ts-body">{c.evidence}</p>
            </div>
          </div>
        </section>
      ))
    }

    <section class="slide" data-slide="8" id="evidence">
      <header class="slide-header">
        <div>
          <p class="slide-kicker">Evidence</p>
          <h2>공개 근거와 면접 열람 범위</h2>
        </div>
        <span class="slide-page">{`8 / ${totalSlides}`}</span>
      </header>
      <p class="section-lead">
        비공개 경로는 면접·기술 미팅에서만 확인합니다. 전략 알파·클라이언트 식별·실계좌 설정은 공개하지 않습니다.
      </p>
      <div class="evidence-grid">
        <div>
          <h3 class="block-title">공개 (PUB)</h3>
          <table class="slide-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>주장</th>
                <th>한계</th>
              </tr>
            </thead>
            <tbody>
              {
                evidenceSlides.pub.map((row) => (
                  <tr>
                    <td>{row.id}</td>
                    <td>{row.claim}</td>
                    <td>{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div>
          <h3 class="block-title">비공개 인용 (PRIV)</h3>
          <table class="slide-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>주장</th>
                <th>열람</th>
              </tr>
            </thead>
            <tbody>
              {
                evidenceSlides.priv.map((row) => (
                  <tr>
                    <td>{row.id}</td>
                    <td>{row.claim}</td>
                    <td>{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="slide slide-closing" data-slide="9" id="closing">
      <header class="slide-header">
        <div>
          <p class="slide-kicker">Closing</p>
          <h2>{closing.headline}</h2>
        </div>
        <span class="slide-page">{`9 / ${totalSlides}`}</span>
      </header>
      <ul class="plain-list closing-points">
        {closing.points.map((p) => <li>{p}</li>)}
      </ul>
      <p class="closing-contact">
        {profile.name} · {profile.role} · {profile.email} · {profile.githubHandle}
      </p>
    </section>
  </div>
</BaseLayout>
